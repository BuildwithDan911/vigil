# Vigil for IRIS for Health - Environment Configuration
# Copy this file to .env and supply your credentials if running in live mode.

# Mode: 'replay' (default, zero live LLM calls, 100% deterministic test suite)
#       'live'   (calls Google Gemini from the Python adapter; falls back to the safety floor if the key is missing or the call fails)
VIGIL_MODE=replay

# Google Gemini API Key (Required only if VIGIL_MODE=live)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# LLM Model used by IRIS AI Hub Agent
GEMINI_MODEL=gemini-3.5-flash-lite

# Hospital Port Mapping
IRIS_WEB_PORT=52773
IRIS_SUPERSERVER_PORT=1972

# Optional IRIS image override. Leave unset to use the public
# intersystemsdc/irishealth-community image (replay mode works with zero keys).
# If you have loaded the official AI Hub EAP tarball, set:
# IMAGE=irishealth-community:2027.1.0AI.109.0
# IMAGE=
